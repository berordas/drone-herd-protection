# Interpolación del docker-compose (docker compose lee este .env automáticamente).
# uid/gid del usuario en el host -> lo que el contenedor escribe en los volúmenes
# (repo y ~/rl_data) queda propiedad del usuario, no de root/jovyan(1000).
# Si otro usuario reutiliza esto: actualizar con `id -u` / `id -g`.
HOST_UID=1047
HOST_GID=987
